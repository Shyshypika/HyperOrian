    let currentSubtitles = [];

    // Safe Storage Wrapper (Prevents crashes in sandboxed iframe environments like Google Sites)
    const SafeStorage = {
      memoryCache: {},
      getItem(key) {
        try {
          return localStorage.getItem(key);
        } catch (e) {
          return this.memoryCache[key] || null;
        }
      },
      setItem(key, value) {
        try {
          localStorage.setItem(key, value);
        } catch (e) {
          this.memoryCache[key] = value;
        }
      },
      removeItem(key) {
        try {
          localStorage.removeItem(key);
        } catch (e) {
          delete this.memoryCache[key];
        }
      }
    };

    // AdShield & Ad-Blocker Engine
    let adShieldEnabled = true;
    let blockedAdsCount = 0;

    function initAdShield() {
      // Intercept popup attempts commonly triggered by embedded ad networks
      try {
        const originalOpen = window.open;
        window.open = function(url, target, features) {
          if (adShieldEnabled) {
            blockedAdsCount++;
            updateAdShieldUI();
            console.log("OmniPlayer AdShield blocked an unrequested popup:", url);
            return null;
          }
          return originalOpen.apply(window, arguments);
        };
      } catch (e) {}
    }

    function sanitizeAdFreeUrl(rawUrl) {
      if (!rawUrl) return rawUrl;
      if (!adShieldEnabled) return rawUrl;

      try {
        let cleanUrl = rawUrl;
        // Strip common ad tracking query parameters
        const urlObj = new URL(rawUrl);
        const trackingParams = ['utm_source', 'utm_medium', 'utm_campaign', 'gclid', 'fbclid', 'si', 'feature'];
        trackingParams.forEach(param => urlObj.searchParams.delete(param));
        cleanUrl = urlObj.toString();

        return cleanUrl;
      } catch (e) {
        return rawUrl;
      }
    }

    function toggleAdShield() {
      adShieldEnabled = !adShieldEnabled;
      updateAdShieldUI();
    }

    function updateAdShieldUI() {
      const btn = document.getElementById('btnToggleAdShield');
      if (!btn) return;
      if (adShieldEnabled) {
        btn.className = "bg-emerald-950/80 hover:bg-emerald-900/90 text-emerald-400 border border-emerald-500/40 px-2.5 py-2 rounded-lg text-xs sm:text-sm font-medium flex items-center space-x-1.5 transition";
        btn.innerHTML = `<i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i><span class="hidden lg:inline text-xs font-semibold">AdShield On</span>`;
      } else {
        btn.className = "bg-slate-800 hover:bg-slate-700 text-slate-400 border border-slate-700/80 px-2.5 py-2 rounded-lg text-xs sm:text-sm font-medium flex items-center space-x-1.5 transition";
        btn.innerHTML = `<i data-lucide="shield-off" class="w-4 h-4 text-slate-400"></i><span class="hidden lg:inline text-xs font-semibold">AdShield Off</span>`;
      }
      if (window.lucide) lucide.createIcons();
    }

    const PROGRESS_STORAGE_KEY = 'omniplayer_video_memory_v1';
    let pendingResumeTime = 0;
    let progressSaveTimer = null;

    function getAllSavedProgress() {
      try {
        const raw = SafeStorage.getItem(PROGRESS_STORAGE_KEY);
        return raw ? JSON.parse(raw) : {};
      } catch (e) {
        return {};
      }
    }

    function saveCurrentVideoProgress() {
      const cur = getCurrentTime();
      const dur = getDuration();
      if (!cur || !dur || dur < 5 || cur < 2) return;

      const memory = getAllSavedProgress();
      const videoData = VIDEO_SOURCES[currentKey] || {};
      
      memory[currentKey] = {
        key: currentKey,
        title: videoData.title || document.getElementById('videoTitleDisplay').textContent || 'Custom Video',
        timestamp: cur,
        duration: dur,
        percent: Math.min(100, Math.round((cur / dur) * 100)),
        lastUpdated: Date.now()
      };

      SafeStorage.setItem(PROGRESS_STORAGE_KEY, JSON.stringify(memory));
      renderMemoryHistoryList();
    }

    function checkAndPromptResume(key) {
      const memory = getAllSavedProgress();
      const record = memory[key];
      const resumeBanner = document.getElementById('resumeBanner');
      const resumeTimeText = document.getElementById('resumeTimeText');

      if (record && record.timestamp > 5 && (record.duration - record.timestamp > 10)) {
        pendingResumeTime = record.timestamp;
        resumeTimeText.textContent = formatTime(record.timestamp);
        
        resumeBanner.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2');
        resumeBanner.classList.add('opacity-100', 'translate-y-0');

        // Auto dismiss resume toast after 8 seconds
        setTimeout(() => hideResumeBanner(), 8000);
      } else {
        hideResumeBanner();
      }
    }

    function hideResumeBanner() {
      const resumeBanner = document.getElementById('resumeBanner');
      if (resumeBanner) {
        resumeBanner.classList.remove('opacity-100', 'translate-y-0');
        resumeBanner.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2');
      }
    }

    function renderMemoryHistoryList() {
      const container = document.getElementById('memoryHistoryList');
      if (!container) return;

      const memory = getAllSavedProgress();
      const keys = Object.keys(memory).sort((a, b) => memory[b].lastUpdated - memory[a].lastUpdated);

      if (keys.length === 0) {
        container.innerHTML = `<div class="text-slate-500 text-center py-3 italic text-[11px]">No saved progress yet. Play a video to record memory!</div>`;
        return;
      }

      container.innerHTML = keys.map(k => {
        const item = memory[k];
        const isCurrent = k === currentKey;
        return `
          <div class="p-2 rounded-xl bg-slate-900/80 border ${isCurrent ? 'border-brand-500/50' : 'border-slate-800'} hover:border-brand-500/30 transition flex flex-col gap-1">
            <div class="flex items-center justify-between text-slate-200">
              <span class="font-semibold truncate max-w-[140px] text-[11px]">${item.title}</span>
              <button onclick="jumpToMemoryKey('${item.key}', ${item.timestamp})" class="text-[10px] text-brand-400 hover:text-brand-300 font-medium px-1.5 py-0.5 bg-brand-500/10 rounded transition cursor-pointer">
                Resume ${formatTime(item.timestamp)}
              </button>
            </div>
            <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
              <div class="bg-brand-500 h-full rounded-full" style="width: ${item.percent}%"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    window.jumpToMemoryKey = function(key, timestamp) {
      if (key !== currentKey) {
        loadVideoKey(key);
      }
      setTimeout(() => {
        setCurrentTime(timestamp);
        hideResumeBanner();
      }, 400);
    };

    function clearAllWatchMemory() {
      SafeStorage.removeItem(PROGRESS_STORAGE_KEY);
      renderMemoryHistoryList();
      hideResumeBanner();
    }

    // Helper to parse YouTube Video ID
    function extractYouTubeId(url) {
      if (!url) return null;
      const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
      const match = url.match(regExp);
      return (match && match[2].length === 11) ? match[2] : null;
    }

    window.onYouTubeIframeAPIReady = function() {
      try {
        ytPlayer = new YT.Player('ytPlayer', {
          height: '100%',
          width: '100%',
          playerVars: {
            controls: 1,
            rel: 0,
            showinfo: 0,
            modestbranding: 1,
            playsinline: 1,
            enablejsapi: 1
          },
          events: {
            onReady: onYouTubePlayerReady,
            onStateChange: onYouTubePlayerStateChange,
            onError: onYouTubePlayerError
          }
        });
      } catch (err) {
        console.warn("YouTube Player API deferred:", err);
      }
    };

    function onYouTubePlayerReady() {
      ytReady = true;
      if (pendingYtId) {
        loadYouTubeVideo(pendingYtId);
        pendingYtId = null;
      }
    }

    function onYouTubePlayerStateChange(event) {
      if (!isYouTubeMode) return;
      if (event.data === YT.PlayerState.PLAYING) {
        showPauseIcon(true);
        hideErrorOverlay();
        loadingSpinner.classList.add('opacity-0');
        startYouTubeTicker();
      } else if (event.data === YT.PlayerState.PAUSED) {
        showPauseIcon(false);
        stopYouTubeTicker();
      } else if (event.data === YT.PlayerState.BUFFERING) {
        loadingSpinner.classList.remove('opacity-0');
      } else if (event.data === YT.PlayerState.ENDED) {
        showPauseIcon(false);
        stopYouTubeTicker();
      }
    }

    function onYouTubePlayerError(e) {
      console.warn("YouTube API restricted in sandboxed frame, invoking iframe fallback:", e);
      if (currentYtId) {
        useDirectYouTubeIframe(currentYtId);
      }
    }

    function useDirectYouTubeIframe(ytId) {
      const ytPlayerDiv = document.getElementById('ytPlayer');
      if (ytPlayerDiv) ytPlayerDiv.classList.add('hidden');
      if (ytFallbackIframe) {
        // Enforce youtube-nocookie.com embed endpoint for privacy and ad shielding
        const sanitizedUrl = `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&controls=1&rel=0&iv_load_policy=3&enablejsapi=1`;
        ytFallbackIframe.src = sanitizedUrl;
        ytFallbackIframe.classList.remove('hidden');
      }
      hideErrorOverlay();
      loadingSpinner.classList.add('opacity-0');
    }

    function startYouTubeTicker() {
      stopYouTubeTicker();
      ytTicker = setInterval(() => {
        if (isYouTubeMode) {
          updateProgress();
        }
      }, 250);
    }

    function stopYouTubeTicker() {
      if (ytTicker) {
        clearInterval(ytTicker);
        ytTicker = null;
      }
    }

    function initPlayer() {
      if (window.lucide) {
        lucide.createIcons();
      }
      initAdShield();
      renderMemoryHistoryList();
      loadVideoKey('big_buck_bunny');
      setupEventListeners();
    }

    function loadVideoKey(key) {
      currentKey = key;
      const data = VIDEO_SOURCES[key];
      if (!data) return;

      document.getElementById('videoTitleDisplay').textContent = data.title;
      document.getElementById('videoDescDisplay').textContent = data.desc;
      currentSubtitles = data.subtitles || [];
      videoSelect.value = key;

      // Check Watch Memory for saved playback spot
      checkAndPromptResume(key);

      // Highlight Active Playlist Item
      document.querySelectorAll('.playlist-item').forEach(item => {
        if (item.dataset.vid === key) {
          item.classList.add('bg-slate-800/80', 'border-accent/40');
          item.classList.remove('border-transparent');
        } else {
          item.classList.remove('bg-slate-800/80', 'border-accent/40');
          item.classList.add('border-transparent');
        }
      });

      if (data.type === 'youtube' || data.ytId) {
        loadYouTubeVideo(data.ytId);
      } else {
        loadSourceUrl(data.url);
      }
    }

    function loadYouTubeVideo(ytId) {
      hideErrorOverlay();
      isYouTubeMode = true;
      currentYtId = ytId;

      try { video.pause(); } catch(e) {}
      video.classList.add('hidden');
      
      // Bring YouTube wrapper to front (z-30) so clicks go directly to YouTube's player
      ytPlayerWrapper.classList.remove('hidden');
      ytPlayerWrapper.classList.add('z-30');
      
      // Adjust controls container so it does not block clicks on YouTube's native UI
      controlsContainer.classList.add('pointer-events-none', 'opacity-0');

      const ytPlayerDiv = document.getElementById('ytPlayer');
      if (ytFallbackIframe) {
        ytFallbackIframe.classList.add('hidden');
        ytFallbackIframe.src = '';
      }
      if (ytPlayerDiv) ytPlayerDiv.classList.remove('hidden');

      if (ytReady && ytPlayer && typeof ytPlayer.loadVideoById === 'function') {
        try {
          ytPlayer.loadVideoById(ytId);
          resetUI();
        } catch (err) {
          useDirectYouTubeIframe(ytId);
        }
      } else {
        pendingYtId = ytId;
        // Direct fallback iframe embed if API takes too long or is blocked by school domain
        setTimeout(() => {
          if (!ytReady && isYouTubeMode) {
            useDirectYouTubeIframe(ytId);
          }
        }, 1000);
      }
    }

    function loadSourceUrl(url) {
      hideErrorOverlay();
      
      const cleanUrl = sanitizeAdFreeUrl(url);
      const parsedYtId = extractYouTubeId(cleanUrl);
      if (parsedYtId) {
        loadYouTubeVideo(parsedYtId);
        return;
      }

      isYouTubeMode = false;
      currentYtId = null;
      stopYouTubeTicker();

      if (ytReady && ytPlayer && typeof ytPlayer.stopVideo === 'function') {
        try { ytPlayer.stopVideo(); } catch(e) {}
      }

      ytPlayerWrapper.classList.add('hidden');
      ytPlayerWrapper.classList.remove('z-30');
      
      video.classList.remove('hidden');
      controlsContainer.classList.remove('pointer-events-none', 'opacity-0');

      try { video.pause(); } catch(e) {}

      if (hls) {
        hls.destroy();
        hls = null;
      }

      if (cleanUrl.includes('.m3u8')) {
        if (window.Hls && Hls.isSupported()) {
          hls = new Hls({ enableWorker: true, lowLatencyMode: true });
          hls.loadSource(cleanUrl);
          hls.attachMedia(video);
          hls.on(Hls.Events.ERROR, function (event, data) {
            if (data.fatal) {
              showErrorOverlay("HLS Stream Error", "Failed to load or parse HLS live playlist.");
            }
          });
        } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
          video.src = cleanUrl;
        } else {
          showErrorOverlay("HLS Unsupported", "Your browser does not support HLS streaming.");
          return;
        }
      } else {
        video.src = cleanUrl;
      }

      video.load();
      resetUI();
    }

    function hideErrorOverlay() {
      if (errorOverlay) {
        errorOverlay.classList.add('opacity-0', 'pointer-events-none');
      }
    }

    function showErrorOverlay(title, msg) {
      if (errorTitle) errorTitle.textContent = title;
      if (errorMessage) errorMessage.textContent = msg;
      if (errorOverlay) {
        errorOverlay.classList.remove('opacity-0', 'pointer-events-none');
      }
    }

    function getCurrentTime() {
      if (isYouTubeMode && ytPlayer && typeof ytPlayer.getCurrentTime === 'function') {
        try { return ytPlayer.getCurrentTime() || 0; } catch(e) { return 0; }
      }
      return video ? (video.currentTime || 0) : 0;
    }

    function getDuration() {
      if (isYouTubeMode && ytPlayer && typeof ytPlayer.getDuration === 'function') {
        try { return ytPlayer.getDuration() || 0; } catch(e) { return 0; }
      }
      return video ? (video.duration || 0) : 0;
    }

    function setCurrentTime(t) {
      if (isYouTubeMode && ytPlayer && typeof ytPlayer.seekTo === 'function') {
        try { ytPlayer.seekTo(t, true); } catch(e) {}
      } else if (video) {
        video.currentTime = t;
      }
    }

    function formatTime(sec) {
      if (isNaN(sec) || sec < 0) return "0:00";
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${m}:${s < 10 ? '0' : ''}${s}`;
    }

    function resetUI() {
      if (seekBar) seekBar.value = 0;
      if (progressBar) progressBar.style.width = '0%';
      if (bufferBar) bufferBar.style.width = '0%';
      if (currentTimeEl) currentTimeEl.textContent = '0:00';
      if (durationEl) durationEl.textContent = '0:00';
      showPauseIcon(false);
    }

    function togglePlay() {
      if (isYouTubeMode) {
        if (ytPlayer && typeof ytPlayer.getPlayerState === 'function') {
          const state = ytPlayer.getPlayerState();
          if (state === YT.PlayerState.PLAYING) {
            ytPlayer.pauseVideo();
            showPauseIcon(false);
          } else {
            ytPlayer.playVideo();
            showPauseIcon(true);
          }
        }
      } else if (video) {
        if (video.paused) {
          video.play().then(() => showPauseIcon(true)).catch(err => {
            console.warn("Autoplay/play blocked:", err);
            video.muted = true;
            video.play().then(() => showPauseIcon(true)).catch(e => console.error(e));
          });
        } else {
          video.pause();
          showPauseIcon(false);
        }
      }
    }

    function showPauseIcon(isPlaying) {
      if (iconPlay && iconPause) {
        if (isPlaying) {
          iconPlay.classList.add('hidden');
          iconPause.classList.remove('hidden');
        } else {
          iconPlay.classList.remove('hidden');
          iconPause.classList.add('hidden');
        }
      }
      if (actionIcon) {
        actionIcon.setAttribute('data-lucide', isPlaying ? 'pause' : 'play');
      }
      if (window.lucide) lucide.createIcons();
    }

    function updateProgress() {
      const cur = getCurrentTime();
      const dur = getDuration();

      if (!dur) return;
      const pct = (cur / dur) * 100;
      seekBar.value = pct;
      progressBar.style.width = `${pct}%`;
      currentTimeEl.textContent = formatTime(cur);
      durationEl.textContent = formatTime(dur);

      // Throttle memory saving to every 2 seconds during playback
      if (Math.abs(cur - (window.lastSavedTimestamp || 0)) > 2) {
        window.lastSavedTimestamp = cur;
        saveCurrentVideoProgress();
      }

      if (isYouTubeMode && ytPlayer && typeof ytPlayer.getVideoLoadedFraction === 'function') {
        bufferBar.style.width = `${ytPlayer.getVideoLoadedFraction() * 100}%`;
      } else if (video.buffered && video.buffered.length > 0) {
        const bufferedEnd = video.buffered.end(video.buffered.length - 1);
        bufferBar.style.width = `${(bufferedEnd / dur) * 100}%`;
      }

      if (subtitlesEnabled && currentSubtitles.length) {
        const sub = currentSubtitles.find(s => cur >= s.start && cur <= s.end);
        if (sub) {
          subtitleText.textContent = sub.text;
          subtitleText.classList.remove('hidden');
        } else {
          subtitleText.classList.add('hidden');
        }
      } else {
        subtitleText.classList.add('hidden');
      }
    }

    function setupEventListeners() {
      video.addEventListener('play', () => showPauseIcon(true));
      video.addEventListener('pause', () => showPauseIcon(false));
      video.addEventListener('timeupdate', updateProgress);
      video.addEventListener('loadedmetadata', () => durationEl.textContent = formatTime(video.duration));

      document.getElementById('btnToggleAdShield').addEventListener('click', toggleAdShield);
      document.getElementById('btnClearMemory').addEventListener('click', clearAllWatchMemory);

      document.getElementById('btnConfirmResume').addEventListener('click', () => {
        if (pendingResumeTime > 0) {
          setCurrentTime(pendingResumeTime);
          hideResumeBanner();
        }
      });

      document.getElementById('btnDismissResume').addEventListener('click', hideResumeBanner);

      document.getElementById('btnRetryLoad').addEventListener('click', () => loadVideoKey(currentKey));
      document.getElementById('btnLoadFallback').addEventListener('click', () => loadVideoKey('big_buck_bunny'));

      video.addEventListener('waiting', () => loadingSpinner.classList.remove('opacity-0'));
      video.addEventListener('canplay', () => {
        loadingSpinner.classList.add('opacity-0');
        hideErrorOverlay();
      });

      video.addEventListener('click', togglePlay);
      btnPlayPause.addEventListener('click', togglePlay);

      seekBar.addEventListener('input', (e) => {
        const dur = getDuration();
        const seekTo = (e.target.value / 100) * dur;
        setCurrentTime(seekTo);
      });

      seekBar.addEventListener('mousemove', (e) => {
        const rect = seekBar.getBoundingClientRect();
        const pos = (e.clientX - rect.left) / rect.width;
        const targetTime = pos * getDuration();
        seekTooltip.textContent = formatTime(targetTime);
        seekTooltip.style.left = `${Math.max(10, Math.min(rect.width - 20, e.clientX - rect.left))}px`;
        seekTooltip.classList.remove('opacity-0');
      });

      seekBar.addEventListener('mouseleave', () => seekTooltip.classList.add('opacity-0'));

      btnRewind.addEventListener('click', () => setCurrentTime(Math.max(0, getCurrentTime() - 10)));
      btnForward.addEventListener('click', () => setCurrentTime(Math.min(getDuration(), getCurrentTime() + 10)));

      volumeSlider.addEventListener('input', (e) => {
        const val = parseFloat(e.target.value);
        if (isYouTubeMode && ytPlayer && typeof ytPlayer.setVolume === 'function') {
          ytPlayer.setVolume(val * 100);
          if (val === 0) ytPlayer.mute(); else ytPlayer.unMute();
        } else {
          video.volume = val;
          video.muted = (val === 0);
        }
        updateVolumeIcon(val === 0);
      });

      btnMute.addEventListener('click', () => {
        if (isYouTubeMode && ytPlayer && typeof ytPlayer.isMuted === 'function') {
          if (ytPlayer.isMuted()) {
            ytPlayer.unMute();
            updateVolumeIcon(false);
          } else {
            ytPlayer.mute();
            updateVolumeIcon(true);
          }
        } else {
          video.muted = !video.muted;
          updateVolumeIcon(video.muted);
        }
      });

      function updateVolumeIcon(isMuted) {
        if (isMuted) {
          iconVolumeHigh.classList.add('hidden');
          iconVolumeMute.classList.remove('hidden');
        } else {
          iconVolumeHigh.classList.remove('hidden');
          iconVolumeMute.classList.add('hidden');
        }
      }

      btnFullscreen.addEventListener('click', toggleFullscreen);

      function toggleFullscreen() {
        if (!document.fullscreenElement) {
          playerContainer.requestFullscreen().catch(err => console.warn(err.message));
        } else {
          document.exitFullscreen();
        }
      }

      document.addEventListener('fullscreenchange', () => {
        if (document.fullscreenElement) {
          iconFullscreen.classList.add('hidden');
          iconMinimize.classList.remove('hidden');
        } else {
          iconFullscreen.classList.remove('hidden');
          iconMinimize.classList.add('hidden');
        }
      });

      btnPip.addEventListener('click', async () => {
        try {
          if (document.pictureInPictureElement) {
            await document.exitPictureInPicture();
          } else if (!isYouTubeMode) {
            await video.requestPictureInPicture();
          } else {
            showErrorOverlay("Picture in Picture", "Picture-in-Picture for YouTube streams is handled natively via the YouTube player menu.");
          }
        } catch (e) { console.error(e); }
      });

      btnCaptions.addEventListener('click', () => {
        subtitlesEnabled = !subtitlesEnabled;
        if (subtitlesEnabled) {
          ccIndicator.classList.remove('hidden');
          btnCaptions.classList.add('text-accent');
        } else {
          ccIndicator.classList.add('hidden');
          btnCaptions.classList.remove('text-accent');
          subtitleText.classList.add('hidden');
        }
      });

      btnSpeedMenu.addEventListener('click', () => speedDropdown.classList.toggle('hidden'));
      document.querySelectorAll('.speed-opt').forEach(opt => {
        opt.addEventListener('click', (e) => {
          const spd = parseFloat(e.target.dataset.speed);
          if (isYouTubeMode && ytPlayer && typeof ytPlayer.setPlaybackRate === 'function') {
            ytPlayer.setPlaybackRate(spd);
          } else {
            video.playbackRate = spd;
          }
          speedLabel.textContent = spd === 1 ? '1x' : `${spd}x`;
          speedDropdown.classList.add('hidden');
        });
      });

      playerContainer.addEventListener('mousemove', () => {
        if (!isYouTubeMode) {
          controlsContainer.classList.remove('opacity-0');
          playerContainer.classList.remove('hide-cursor');
          clearTimeout(controlsTimeout);
          controlsTimeout = setTimeout(() => {
            controlsContainer.classList.add('opacity-0');
            playerContainer.classList.add('hide-cursor');
          }, 2500);
        }
      });

      videoSelect.addEventListener('change', (e) => loadVideoKey(e.target.value));

      document.querySelectorAll('.playlist-item').forEach(item => {
        item.addEventListener('click', () => loadVideoKey(item.dataset.vid));
      });

      document.querySelectorAll('.btn-jump').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const t = parseFloat(e.currentTarget.dataset.jump);
          setCurrentTime(t);
        });
      });

      document.getElementById('fileInput').addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
          const fileUrl = URL.createObjectURL(file);
          document.getElementById('videoTitleDisplay').textContent = file.name;
          document.getElementById('videoDescDisplay').textContent = "Loaded from local file";
          loadSourceUrl(fileUrl);
        }
      });

      document.querySelectorAll('.theme-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          document.body.className = `bg-slate-950 text-slate-100 min-h-screen flex flex-col ${e.target.dataset.theme} antialiased overflow-x-hidden`;
        });
      });

      setupModals();
    }

    document.addEventListener('keydown', (e) => {
      if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) return;

      switch (e.key.toLowerCase()) {
        case ' ':
        case 'k':
          e.preventDefault();
          togglePlay();
          break;
        case 'f':
          e.preventDefault();
          btnFullscreen.click();
          break;
        case 'm':
          e.preventDefault();
          btnMute.click();
          break;
        case 'arrowleft':
          e.preventDefault();
          setCurrentTime(Math.max(0, getCurrentTime() - 5));
          break;
        case 'arrowright':
          e.preventDefault();
          setCurrentTime(Math.min(getDuration(), getCurrentTime() + 5));
          break;
      }
    });

    function setupModals() {
      const embedModal = document.getElementById('embedModal');
      const urlModal = document.getElementById('urlModal');
      const shortcutsModal = document.getElementById('shortcutsModal');

      document.getElementById('btnOpenEmbedModal').addEventListener('click', () => {
        updateEmbedSnippet();
        embedModal.classList.remove('hidden');
      });

      document.getElementById('btnCloseEmbedModal').addEventListener('click', () => embedModal.classList.add('hidden'));
      document.getElementById('btnOpenUrlModal').addEventListener('click', () => urlModal.classList.remove('hidden'));
      document.getElementById('btnCloseUrlModal').addEventListener('click', () => urlModal.classList.add('hidden'));
      document.getElementById('btnOpenShortcuts').addEventListener('click', () => shortcutsModal.classList.remove('hidden'));
      document.getElementById('btnCloseShortcuts').addEventListener('click', () => shortcutsModal.classList.add('hidden'));

      document.getElementById('btnLoadCustomUrl').addEventListener('click', () => {
        const url = document.getElementById('customUrlInput').value.trim();
        if (url) {
          const ytId = extractYouTubeId(url);
          document.getElementById('videoTitleDisplay').textContent = ytId ? "YouTube Stream" : "Custom Stream Source";
          document.getElementById('videoDescDisplay').textContent = url;
          if (ytId) loadYouTubeVideo(ytId); else loadSourceUrl(url);
          urlModal.classList.add('hidden');
        }
      });

      ['embedAutoplay', 'embedMuted', 'embedControls'].forEach(id => {
        document.getElementById(id).addEventListener('change', updateEmbedSnippet);
      });

      document.getElementById('btnCopyEmbed').addEventListener('click', () => {
        const textarea = document.getElementById('embedCodeTextarea');
        textarea.select();
        document.execCommand('copy');
        
        const statusText = document.getElementById('copyStatusText');
        statusText.textContent = "Copied!";
        setTimeout(() => statusText.textContent = "Copy Snippet", 2000);
      });
    }

    function updateEmbedSnippet() {
      const isAutoplay = document.getElementById('embedAutoplay').checked;
      const isMuted = document.getElementById('embedMuted').checked;
      const hasControls = document.getElementById('embedControls').checked;
      
      let code = "";
      if (isYouTubeMode && currentYtId) {
        code = `<iframe width="100%" height="100%" style="min-height:360px; width:100%;" src="https://www.youtube-nocookie.com/embed/${currentYtId}?autoplay=${isAutoplay ? 1 : 0}&mute=${isMuted ? 1 : 0}&controls=${hasControls ? 1 : 0}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
      } else {
        const videoUrl = VIDEO_SOURCES[currentKey] ? VIDEO_SOURCES[currentKey].url : video.src;
        code = `<iframe src="${videoUrl}" width="100%" height="100%" style="min-height:360px; width:100%;" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; encrypted-media" ${isMuted ? 'muted' : ''} ${hasControls ? 'controls' : ''} allowfullscreen></iframe>`;
      }
      document.getElementById('embedCodeTextarea').value = code;
    }

    window.onload = initPlayer;
  </script>
</body>
</html>
