<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OmniPlayer - Modern Embedded Video Player</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f5f3ff',
              100: '#ede9fe',
              500: '#8b5cf6',
              600: '#7c3aed',
              700: '#6d28d9',
            }
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <!-- HLS.js for .m3u8 live video stream support -->
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>

  <!-- YouTube IFrame API -->
  <script src="https://www.youtube.com/iframe_api"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
      user-select: none;
    }

    /* Custom Seek Bar Slider */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      cursor: pointer;
    }

    input[type="range"]::-webkit-slider-track {
      background: rgba(255, 255, 255, 0.2);
      border-radius: 9999px;
      height: 6px;
    }

    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      height: 14px;
      width: 14px;
      background-color: #ffffff;
      border-radius: 50%;
      box-shadow: 0 0 10px rgba(0,0,0,0.5);
      transition: transform 0.1s ease;
      margin-top: -4px;
    }

    input[type="range"]:hover::-webkit-slider-thumb {
      transform: scale(1.3);
    }

    /* Dynamic Accent Theme Classes */
    .theme-violet { --accent-color: #8b5cf6; }
    .theme-emerald { --accent-color: #10b981; }
    .theme-rose { --accent-color: #f43f5e; }
    .theme-amber { --accent-color: #f59e0b; }
    .theme-cyan { --accent-color: #06b6d4; }

    .bg-accent { background-color: var(--accent-color, #8b5cf6); }
    .text-accent { color: var(--accent-color, #8b5cf6); }
    .border-accent { border-color: var(--accent-color, #8b5cf6); }

    /* Hide Controls Timeout Cursor */
    .hide-cursor {
      cursor: none;
    }

    /* Glassmorphic Effects */
    .glass-panel {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col theme-violet antialiased overflow-x-hidden">

  <!-- Top Navigation Header -->
  <header class="border-b border-slate-800/80 bg-slate-900/60 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Logo & Branding -->
      <div class="flex items-center space-x-3">
        <div class="p-2 bg-gradient-to-tr from-brand-600 to-indigo-500 rounded-xl shadow-lg shadow-brand-500/20">
          <i data-lucide="play" class="w-5 h-5 text-white fill-white"></i>
        </div>
        <div>
          <h1 class="font-bold text-lg leading-none text-white tracking-tight">OmniPlayer</h1>
          <span class="text-xs text-slate-400 font-medium">Embeddable HTML5 & HLS Media Suite</span>
        </div>
      </div>

      <!-- Action Controls Header -->
      <div class="flex items-center space-x-2 sm:space-x-3">
        <!-- Preset Playlist Dropdown -->
        <div class="relative group">
          <select id="videoSelect" class="bg-slate-800 hover:bg-slate-700/80 text-xs sm:text-sm text-slate-200 border border-slate-700/80 rounded-lg px-3 py-2 pr-8 focus:outline-none focus:border-brand-500 transition appearance-none cursor-pointer">
            <option value="big_buck_bunny">Big Buck Bunny (1080p MP4)</option>
            <option value="oceans">Oceans World (1080p MP4)</option>
            <option value="sintel">Sintel Movie (W3C Sample MP4)</option>
            <option value="yt_tears_of_steel">YouTube: Developer Demo</option>
            <option value="yt_lofi">YouTube: Big Buck Bunny 4K</option>
            <option value="hls_stream">HLS Test Stream (.m3u8)</option>
          </select>
          <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
        </div>

        <!-- Local File Load Button -->
        <label class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-3 py-2 rounded-lg text-xs sm:text-sm font-medium flex items-center space-x-2 cursor-pointer border border-slate-700/80 transition">
          <i data-lucide="upload" class="w-4 h-4 text-slate-400"></i>
          <span class="hidden md:inline">Load File</span>
          <input type="file" id="fileInput" accept="video/*" class="hidden">
        </label>

        <!-- Custom Stream URL Modal Trigger -->
        <button id="btnOpenUrlModal" class="bg-slate-800 hover:bg-slate-700 text-slate-200 p-2 sm:px-3 sm:py-2 rounded-lg text-xs sm:text-sm font-medium flex items-center space-x-2 border border-slate-700/80 transition" title="Load custom Stream URL">
          <i data-lucide="link" class="w-4 h-4 text-slate-400"></i>
          <span class="hidden md:inline">URL</span>
        </button>

        <!-- AdShield Ad Blocker Toggle Button -->
        <button id="btnToggleAdShield" class="bg-emerald-950/80 hover:bg-emerald-900/90 text-emerald-400 border border-emerald-500/40 px-2.5 py-2 rounded-lg text-xs sm:text-sm font-medium flex items-center space-x-1.5 transition" title="AdShield & Privacy Guard Active">
          <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i>
          <span class="hidden lg:inline text-xs font-semibold">AdShield On</span>
        </button>

        <!-- Embed Generator Button -->
        <button id="btnOpenEmbedModal" class="bg-brand-600 hover:bg-brand-700 text-white px-3 py-2 rounded-lg text-xs sm:text-sm font-medium flex items-center space-x-2 shadow-lg shadow-brand-600/25 transition">
          <i data-lucide="code" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Get Embed Code</span>
        </button>

        <!-- Shortcuts Modal Trigger -->
        <button id="btnOpenShortcuts" class="text-slate-400 hover:text-slate-200 p-2 rounded-lg transition" title="Keyboard Shortcuts">
          <i data-lucide="keyboard" class="w-5 h-5"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Application Body -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 flex flex-col lg:flex-row gap-6">
    
    <!-- Player Wrapper Column -->
    <div class="flex-1 flex flex-col gap-4">
      
      <!-- Video Container Frame -->
      <div id="playerContainer" class="relative group bg-black rounded-2xl overflow-hidden shadow-2xl shadow-black/80 aspect-video w-full border border-slate-800 select-none">
        
        <!-- HTML5 Video Element -->
        <video id="mainVideo" class="w-full h-full object-contain cursor-pointer" playsinline webkit-playsinline></video>

        <!-- YouTube Player Wrapper (z-30 when active to guarantee direct click capability) -->
        <div id="ytPlayerWrapper" class="w-full h-full absolute inset-0 hidden pointer-events-auto z-30">
          <div id="ytPlayer" class="w-full h-full pointer-events-auto"></div>
          <iframe id="ytFallbackIframe" class="w-full h-full hidden pointer-events-auto" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>

        <!-- Resume Playback Toast Banner -->
        <div id="resumeBanner" class="absolute top-4 left-4 right-16 z-40 bg-slate-900/95 border border-brand-500/50 backdrop-blur-md p-3 rounded-xl shadow-2xl flex items-center justify-between opacity-0 pointer-events-none transition-all duration-300 -translate-y-2">
          <div class="flex items-center space-x-2 min-w-0 pr-2">
            <div class="p-1.5 bg-brand-500/20 text-brand-400 rounded-lg shrink-0">
              <i data-lucide="history" class="w-4 h-4"></i>
            </div>
            <div class="truncate">
              <p class="text-xs font-semibold text-white">Resume Playback?</p>
              <p class="text-[11px] text-slate-300 truncate">Saved spot at <span id="resumeTimeText" class="font-mono font-bold text-brand-300">00:00</span></p>
            </div>
          </div>
          <div class="flex items-center space-x-1.5 shrink-0">
            <button id="btnConfirmResume" class="bg-brand-600 hover:bg-brand-500 text-white text-xs px-2.5 py-1 rounded-lg font-medium transition cursor-pointer">
              Resume
            </button>
            <button id="btnDismissResume" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-2 py-1 rounded-lg transition cursor-pointer">
              Start Over
            </button>
          </div>
        </div>

        <!-- Dynamic On-Screen Loading Spinner -->
        <div id="loadingSpinner" class="absolute inset-0 flex items-center justify-center bg-black/40 backdrop-blur-xs pointer-events-none opacity-0 transition-opacity duration-300 z-10">
          <div class="w-12 h-12 border-4 border-slate-600 border-t-accent rounded-full animate-spin"></div>
        </div>

        <!-- Dynamic Error Display Overlay -->
        <div id="errorOverlay" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950/90 text-center p-6 opacity-0 pointer-events-none transition-opacity duration-300 z-40">
          <div class="p-3 bg-rose-500/20 text-rose-400 rounded-full mb-3">
            <i data-lucide="alert-triangle" class="w-8 h-8"></i>
          </div>
          <h4 class="text-white font-bold text-base mb-1" id="errorTitle">Video Source Error</h4>
          <p class="text-xs text-slate-400 max-w-md mb-4" id="errorMessage">The requested media source could not be loaded or cross-origin access was restricted by your browser sandbox.</p>
          <div class="flex items-center space-x-2">
            <button id="btnRetryLoad" class="bg-brand-600 hover:bg-brand-700 text-white text-xs px-3 py-1.5 rounded-lg font-medium transition cursor-pointer">
              Retry Load
            </button>
            <button id="btnLoadFallback" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3 py-1.5 rounded-lg font-medium border border-slate-700 transition cursor-pointer">
              Load Backup Stream
            </button>
          </div>
        </div>

        <!-- Big Play/Pause Animation Overlay Indicator -->
        <div id="actionIndicator" class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 scale-50 transition-all duration-300 z-20">
          <div class="p-5 bg-black/60 rounded-full text-white backdrop-blur-md">
            <i id="actionIcon" data-lucide="play" class="w-10 h-10"></i>
          </div>
        </div>

        <!-- Subtitles Display Layer -->
        <div id="subtitleOverlay" class="absolute bottom-16 left-0 right-0 px-8 text-center pointer-events-none z-20 transition-all duration-300">
          <span id="subtitleText" class="inline-block bg-black/80 text-white font-medium text-sm sm:text-base md:text-lg px-4 py-1.5 rounded-md shadow-md backdrop-blur-xs max-w-2xl hidden"></span>
        </div>

        <!-- Watermark / Brand Overlay -->
        <div class="absolute top-4 right-4 pointer-events-none opacity-50 group-hover:opacity-80 transition-opacity z-10">
          <span class="text-xs font-bold tracking-widest text-slate-300 uppercase bg-black/40 px-2.5 py-1 rounded-full border border-white/10 backdrop-blur-md">
            OmniPlayer
          </span>
        </div>

        <!-- Custom Controls Overlay Bar (Active for HTML5 / HLS, non-blocking for YouTube) -->
        <div id="controlsContainer" class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent p-3 sm:p-4 opacity-100 transition-opacity duration-300 z-20 flex flex-col justify-end space-y-2">
          
          <!-- Progress Bar & Tooltip Container -->
          <div class="relative w-full group/seek flex items-center">
            
            <!-- Seek Time Hover Tooltip -->
            <div id="seekTooltip" class="absolute -top-10 -translate-x-1/2 bg-slate-900 text-slate-200 text-xs px-2 py-1 rounded border border-slate-700 shadow pointer-events-none opacity-0 transition-opacity duration-150">
              00:00
            </div>

            <!-- Custom Seek Range & Buffer Overlay -->
            <div class="relative w-full h-1.5 hover:h-2.5 transition-all duration-200 bg-slate-700/60 rounded-full overflow-hidden cursor-pointer flex items-center">
              <!-- Buffer Progress Bar -->
              <div id="bufferBar" class="absolute left-0 top-0 bottom-0 bg-slate-500/40 w-0 transition-all duration-300"></div>
              <!-- Played Progress Bar -->
              <div id="progressBar" class="absolute left-0 top-0 bottom-0 bg-accent w-0"></div>
              <!-- Native Transparent Range Input -->
              <input type="range" id="seekBar" min="0" max="100" value="0" step="0.1" class="absolute inset-0 w-full h-full opacity-0 z-10 cursor-pointer">
            </div>
          </div>

          <!-- Control Buttons Toolbar -->
          <div class="flex items-center justify-between text-slate-200 pt-1">
            
            <!-- Left Group: Playback, Skip, Volume, Timer -->
            <div class="flex items-center space-x-2 sm:space-x-4">
              <!-- Play / Pause Button -->
              <button id="btnPlayPause" class="hover:text-white transition p-1 text-slate-200 focus:outline-none" title="Play/Pause (Space)">
                <i data-lucide="play" id="iconPlay" class="w-5 h-5 sm:w-6 sm:h-6 fill-current"></i>
                <i data-lucide="pause" id="iconPause" class="w-5 h-5 sm:w-6 sm:h-6 fill-current hidden"></i>
              </button>

              <!-- Skip Backward 10s -->
              <button id="btnRewind" class="hover:text-white transition p-1 text-slate-300" title="Rewind 10s (Left Arrow)">
                <i data-lucide="rotate-ccw" class="w-4 h-4 sm:w-5 sm:h-5"></i>
              </button>

              <!-- Skip Forward 10s -->
              <button id="btnForward" class="hover:text-white transition p-1 text-slate-300" title="Forward 10s (Right Arrow)">
                <i data-lucide="rotate-cw" class="w-4 h-4 sm:w-5 sm:h-5"></i>
              </button>

              <!-- Volume Control Container -->
              <div class="flex items-center space-x-2 group/volume relative">
                <button id="btnMute" class="hover:text-white transition p-1 text-slate-300" title="Mute/Unmute (M)">
                  <i data-lucide="volume-2" id="iconVolumeHigh" class="w-5 h-5"></i>
                  <i data-lucide="volume-x" id="iconVolumeMute" class="w-5 h-5 hidden text-rose-400"></i>
                </button>
                <div class="w-0 group-hover/volume:w-20 sm:w-16 md:w-20 transition-all duration-300 overflow-hidden flex items-center">
                  <input type="range" id="volumeSlider" min="0" max="1" step="0.05" value="1" class="w-16">
                </div>
              </div>

              <!-- Time Counter Display -->
              <div class="text-xs font-mono text-slate-300 select-none ml-1">
                <span id="currentTime">0:00</span> / <span id="duration">0:00</span>
              </div>
            </div>

            <!-- Right Group: Captions, Speed, PiP, Fullscreen -->
            <div class="flex items-center space-x-1 sm:space-x-3">
              <!-- Captions / Subtitles Toggle -->
              <button id="btnCaptions" class="p-1.5 rounded hover:bg-slate-800 text-slate-400 hover:text-white transition relative" title="Subtitles / CC">
                <i data-lucide="subtitles" class="w-4 h-4 sm:w-5 sm:h-5"></i>
                <span id="ccIndicator" class="absolute bottom-1 right-1 w-1.5 h-1.5 bg-accent rounded-full hidden"></span>
              </button>

              <!-- Speed Selector Dropdown -->
              <div class="relative">
                <button id="btnSpeedMenu" class="px-2 py-1 text-xs font-semibold rounded hover:bg-slate-800 text-slate-300 hover:text-white transition" title="Playback Speed">
                  <span id="speedLabel">1x</span>
                </button>
                <div id="speedDropdown" class="hidden absolute bottom-full right-0 mb-2 w-28 bg-slate-900 border border-slate-800 rounded-lg shadow-xl overflow-hidden py-1 text-xs z-30">
                  <button data-speed="0.5" class="speed-opt w-full px-3 py-1.5 text-left hover:bg-slate-800 text-slate-300">0.5x</button>
                  <button data-speed="0.75" class="speed-opt w-full px-3 py-1.5 text-left hover:bg-slate-800 text-slate-300">0.75x</button>
                  <button data-speed="1" class="speed-opt w-full px-3 py-1.5 text-left hover:bg-slate-800 text-accent font-bold">1.0x (Normal)</button>
                  <button data-speed="1.25" class="speed-opt w-full px-3 py-1.5 text-left hover:bg-slate-800 text-slate-300">1.25x</button>
                  <button data-speed="1.5" class="speed-opt w-full px-3 py-1.5 text-left hover:bg-slate-800 text-slate-300">1.5x</button>
                  <button data-speed="2" class="speed-opt w-full px-3 py-1.5 text-left hover:bg-slate-800 text-slate-300">2.0x</button>
                </div>
              </div>

              <!-- Picture-in-Picture Toggle -->
              <button id="btnPip" class="p-1.5 rounded hover:bg-slate-800 text-slate-300 hover:text-white transition" title="Picture in Picture">
                <i data-lucide="picture-in-picture-2" class="w-4 h-4 sm:w-5 sm:h-5"></i>
              </button>

              <!-- Fullscreen Toggle -->
              <button id="btnFullscreen" class="p-1.5 rounded hover:bg-slate-800 text-slate-300 hover:text-white transition" title="Fullscreen (F)">
                <i data-lucide="maximize" id="iconFullscreen" class="w-4 h-4 sm:w-5 sm:h-5"></i>
                <i data-lucide="minimize" id="iconMinimize" class="w-4 h-4 sm:w-5 sm:h-5 hidden"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Video Information & Controls Ribbon -->
      <div class="glass-panel rounded-2xl p-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <h2 id="videoTitleDisplay" class="text-lg font-bold text-white">Big Buck Bunny</h2>
          <p id="videoDescDisplay" class="text-xs text-slate-400 mt-0.5">Open source animated feature video sample. 1080p high definition stream.</p>
        </div>

        <!-- Color Theme Accent Selector -->
        <div class="flex items-center space-x-2 border-t md:border-t-0 pt-3 md:pt-0 border-slate-800 w-full md:w-auto justify-end">
          <span class="text-xs text-slate-400 font-medium mr-1">Player Accent:</span>
          <button data-theme="theme-violet" class="theme-btn w-6 h-6 rounded-full bg-violet-600 ring-2 ring-violet-400 ring-offset-2 ring-offset-slate-900 transition"></button>
          <button data-theme="theme-emerald" class="theme-btn w-6 h-6 rounded-full bg-emerald-500 hover:scale-110 transition"></button>
          <button data-theme="theme-cyan" class="theme-btn w-6 h-6 rounded-full bg-cyan-500 hover:scale-110 transition"></button>
          <button data-theme="theme-amber" class="theme-btn w-6 h-6 rounded-full bg-amber-500 hover:scale-110 transition"></button>
          <button data-theme="theme-rose" class="theme-btn w-6 h-6 rounded-full bg-rose-500 hover:scale-110 transition"></button>
        </div>
      </div>
    </div>

    <!-- Right Sidebar Playlist & Chapters -->
    <aside class="w-full lg:w-80 flex flex-col gap-4">
      
      <!-- Watch Memory & Saved Progress Card -->
      <div class="glass-panel rounded-2xl p-4 flex flex-col gap-3">
        <div class="flex items-center justify-between border-b border-slate-800/80 pb-2">
          <h3 class="text-sm font-semibold text-slate-200 flex items-center space-x-2">
            <i data-lucide="history" class="w-4 h-4 text-brand-400"></i>
            <span>Watch Memory</span>
          </h3>
          <button id="btnClearMemory" class="text-[11px] text-slate-400 hover:text-rose-400 transition flex items-center space-x-1" title="Clear watch progress history">
            <i data-lucide="trash-2" class="w-3 h-3"></i>
            <span>Clear</span>
          </button>
        </div>

        <!-- Progress Memory Items List Container -->
        <div id="memoryHistoryList" class="space-y-2 max-h-48 overflow-y-auto pr-1 text-xs">
          <div class="text-slate-500 text-center py-3 italic text-[11px]">No saved progress yet. Play a video to record memory!</div>
        </div>
      </div>

      <!-- Media Quick Switcher Card -->
      <div class="glass-panel rounded-2xl p-4 flex flex-col gap-3">
        <h3 class="text-sm font-semibold text-slate-200 flex items-center space-x-2">
          <i data-lucide="film" class="w-4 h-4 text-accent"></i>
          <span>Sample Library</span>
        </h3>

        <div class="space-y-2" id="playlistItems">
          <!-- Item 1: Big Buck Bunny (HTML5 MP4) -->
          <div data-vid="big_buck_bunny" class="playlist-item active-playlist flex items-center space-x-3 p-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-800 cursor-pointer border border-accent/40 transition">
            <div class="w-16 h-10 bg-slate-900 rounded-lg overflow-hidden flex-shrink-0 relative">
              <img src="https://images.unsplash.com/photo-1534447677768-be436bb09401?w=120&auto=format&fit=crop&q=60" class="w-full h-full object-cover" alt="Big Buck Bunny">
              <span class="absolute top-1 left-1 bg-emerald-600 text-[8px] font-bold text-white px-1 rounded">MP4</span>
              <i data-lucide="play" class="w-3.5 h-3.5 text-white absolute inset-0 m-auto"></i>
            </div>
            <div class="min-w-0 flex-1">
              <h4 class="text-xs font-semibold text-white truncate">Big Buck Bunny</h4>
              <p class="text-[11px] text-slate-400">1080p MP4 • Direct Stream</p>
            </div>
          </div>

          <!-- Item 2: Oceans World (HTML5 MP4) -->
          <div data-vid="oceans" class="playlist-item flex items-center space-x-3 p-2.5 rounded-xl hover:bg-slate-800/60 cursor-pointer border border-transparent transition">
            <div class="w-16 h-10 bg-slate-900 rounded-lg overflow-hidden flex-shrink-0 relative">
              <img src="https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=120&auto=format&fit=crop&q=60" class="w-full h-full object-cover" alt="Oceans">
              <span class="absolute top-1 left-1 bg-emerald-600 text-[8px] font-bold text-white px-1 rounded">MP4</span>
              <i data-lucide="play" class="w-3.5 h-3.5 text-white absolute inset-0 m-auto opacity-70"></i>
            </div>
            <div class="min-w-0 flex-1">
              <h4 class="text-xs font-semibold text-slate-200 truncate">Oceans World</h4>
              <p class="text-[11px] text-slate-400">Nature Documentary</p>
            </div>
          </div>

          <!-- Item 3: Sintel Open Movie (HTML5 MP4) -->
          <div data-vid="sintel" class="playlist-item flex items-center space-x-3 p-2.5 rounded-xl hover:bg-slate-800/60 cursor-pointer border border-transparent transition">
            <div class="w-16 h-10 bg-slate-900 rounded-lg overflow-hidden flex-shrink-0 relative">
              <img src="https://images.unsplash.com/photo-1578632767115-351597cf2477?w=120&auto=format&fit=crop&q=60" class="w-full h-full object-cover" alt="Sintel Trailer">
              <span class="absolute top-1 left-1 bg-emerald-600 text-[8px] font-bold text-white px-1 rounded">MP4</span>
              <i data-lucide="play" class="w-3.5 h-3.5 text-white absolute inset-0 m-auto opacity-70"></i>
            </div>
            <div class="min-w-0 flex-1">
